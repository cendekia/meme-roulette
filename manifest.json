{
  "manifest_version": 3,
  "name": "Meme Roulette - Random Imgur Fun",
  "version": "1.1",
  "description": "🎲 Discover hilarious memes from Imgur with just one click! 🎯",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
} 